---
// Root entry point. It selects a locale without hiding content from no-JS clients.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eduardo Saavedra — Software Engineer</title>
    <meta
      name="description"
      content="Portafolio de Eduardo Saavedra, Software Engineer. Elige un idioma para continuar."
    />
    <link rel="canonical" href="https://chelalo.me/es/" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f3f7fe" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <noscript>
      <meta http-equiv="refresh" content="0;url=/es/" />
    </noscript>
    <style>
      :root {
        color-scheme: light;
        --bg: #f3f7fe;
        --text: #0a1a33;
        --muted: #586b8a;
        --accent: #1d5cf5;
        --line: #d7e2f6;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
        background:
          radial-gradient(40rem 28rem at 80% 0%, rgba(29, 92, 245, 0.12), transparent 60%),
          var(--bg);
        color: var(--text);
        font-family: 'Ubuntu', system-ui, sans-serif;
      }
      main { max-width: 34rem; text-align: center; }
      .brand { color: var(--accent); font-weight: 700; letter-spacing: -0.02em; }
      h1 { margin: 0.75rem 0 0; font-size: clamp(2rem, 6vw, 3rem); line-height: 1.05; }
      p { color: var(--muted); }
      nav { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; margin-top: 1.5rem; }
      a {
        padding: 0.7rem 1.1rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
      }
      a:first-child { border-color: transparent; background: var(--accent); color: #fff; }
    </style>
    <script is:inline>
      (() => {
        let locale = 'es'
        try {
          const stored = localStorage.getItem('language')
          if (stored === 'en' || stored === 'es') {
            locale = stored
          } else if (navigator.language.toLowerCase().startsWith('en')) {
            locale = 'en'
          }
        } catch {
          /* Keep the Spanish default. */
        }
        window.location.replace(`/${locale}/${window.location.hash}`)
      })()
    </script>
  </head>
  <body>
    <main>
      <p class="brand">chelalo</p>
      <h1>Eduardo Saavedra</h1>
      <p>Software Engineer · Backend, datos y producto.</p>
      <noscript>
        <p>Elige un idioma / Choose a language:</p>
        <nav aria-label="Language">
          <a href="/es/" hreflang="es" lang="es">Español</a>
          <a href="/en/" hreflang="en" lang="en">English</a>
        </nav>
      </noscript>
    </main>
  </body>
</html>
