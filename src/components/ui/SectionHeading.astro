---
type Props = {
  eyebrow: string
  title: string
  lead?: string
  id?: string
}

const { eyebrow, title, lead, id } = Astro.props
---

<div class="section-heading reveal" id={id}>
  <div class="section-heading__body">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {lead && <p>{lead}</p>}
  </div>
  <slot />
</div>
