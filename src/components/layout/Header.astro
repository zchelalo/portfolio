---
import Icon from '@/components/ui/Icon.astro'
import ThemeToggle from './ThemeToggle.astro'
import {
  alternateLocale,
  getDictionary,
  homePath,
  swapLocale,
  type Locale,
} from '@/i18n/ui'
import { site } from '@/data/site'

type Props = {
  locale: Locale
  languageHref?: string
}

const { locale, languageHref } = Astro.props
const dict = getDictionary(locale)
const other = alternateLocale(locale)
const path = Astro.url.pathname
const targetLanguageHref = languageHref ?? swapLocale(path, other)

const navItems = [
  { href: `${homePath(locale)}#projects`, label: dict.nav.work },
  { href: `${homePath(locale)}#experience`, label: dict.nav.experience },
  { href: `${homePath(locale)}#capabilities`, label: dict.nav.capabilities },
  { href: `${homePath(locale)}#contact`, label: dict.nav.contact },
]
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href={homePath(locale)}>
      chelalo
    </a>

    <nav class="nav-desktop" aria-label={dict.nav.home}>
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        class="button button--ghost button--small cv-link"
        href={site.cv[locale]}
        type="application/pdf"
      >
        <Icon name="download" size={15} />
        {dict.nav.cv}
      </a>
      <ThemeToggle locale={locale} />
      <a
        class="lang-switch"
        href={targetLanguageHref}
        hreflang={other}
        lang={other}
        aria-label={`${other.toUpperCase()} — ${dict.otherLabel}`}
      >
        {other.toUpperCase()}
      </a>

      <details class="mobile-nav" data-mobile-nav>
        <summary aria-label={dict.a11y.menu}>
          <Icon name="menu" size={20} />
        </summary>
        <nav class="mobile-nav__panel" aria-label={dict.nav.home}>
          {navItems.map((item) => (
            <a href={item.href}>
              {item.label}
              <Icon name="arrow-right" size={16} />
            </a>
          ))}
          <a class="button button--primary" href={site.cv[locale]}>
            <Icon name="download" size={16} />
            {dict.nav.cv}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]')

  const updateHeader = () => {
    header?.setAttribute('data-scrolled', String(window.scrollY > 12))
  }

  updateHeader()
  window.addEventListener('scroll', updateHeader, { passive: true })

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.removeAttribute('open'))
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') menu?.removeAttribute('open')
  })
</script>

<style>
  .cv-link {
    gap: 0.4rem;
  }

  @media (max-width: 900px) {
    .cv-link {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .header-actions {
      gap: 0.3rem;
    }

    .lang-switch {
      min-width: 2.4rem;
      padding-inline: 0.35rem;
    }
  }
</style>
